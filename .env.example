# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# ---------------------------------------------------------------------------
# Obrigatoria. Em producao, use o endpoint com pool do Neon - o host termina
# em "-pooler":
# DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
#
# Desenvolvimento local:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Tamanho maximo do pool de conexoes. Em serverless (Vercel) mantenha baixo.
# DATABASE_POOL_MAX="5"

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Obrigatoria. Sem ela a aplicacao nao sobe. Gere uma com: npm run secret
# Trocar este valor invalida todas as sessoes ativas.
JWT_SECRET=""

# ---------------------------------------------------------------------------
# Perguntas de compreensao
# ---------------------------------------------------------------------------
# Opcional. Sem ela o questionario ao fim da leitura fica indisponivel e o
# resto da aplicacao segue normal. Chave em https://console.anthropic.com
# ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Lembrete diario (US-43)
# ---------------------------------------------------------------------------
# Opcional. Sem estas variaveis o cartao de lembrete some dos Ajustes e o
# agendador responde 401 - o resto da aplicacao segue normal.
#
# O par de chaves VAPID e gerado localmente e nao depende de contratar nada:
#
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log('NEXT_PUBLIC_VAPID_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
#
# A publica vai para o navegador (dai o prefixo NEXT_PUBLIC_); a privada, nao.
# NEXT_PUBLIC_VAPID_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:voce@exemplo.com"

# Segredo que separa o agendador de quem descobrir a rota do cron.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=""
